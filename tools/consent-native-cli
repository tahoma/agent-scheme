# Minimal native CLI process-boundary entrypoint for the native CLI and daemon
# host adapter (docs/native-cli-daemon-adapter.md). Runs the adapter under Emacs
# batch across a real OS process boundary and emits Scheme-readable boundary
# records on stdout; approval prompts and diagnostics go to stderr.
#
# Usage: tools/consent-native-cli OPERATION [OPTIONS]
# See tools/consent-native-cli.el for the operation table and options.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
emacs=${CONSENT_EMACS:-${EMACS:-emacs}}

exec "$emacs" -Q --batch \
  -L "$repo_root/lisp" \
  --load "$repo_root/tools/consent-native-cli.el" \
  -f consent-native-cli-main \
  -- "$@"
