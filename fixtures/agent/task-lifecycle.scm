  ((id successful-completion)
   (status implemented)
   (description "The minimal runner performs one gated action and verifier-stamped finish.")
   (runner
    ((goal replace-helper)
     (options
      ((id-prefix fixture-success)
       (provider ((code-action (file-write "out.txt" payload))
                  (finish done)))
       (operations ((file-write host-mutation file-system)
                    (read-file host-observation file-system)))
       (verifier passed)))))
   (expect
    ((state complete)
     (receipt task-stop)
     (reason completed-goal)
     (event-order (agent-yield agent-progress model-route capability-call
                               model-route))
     (plan-updates ((task-plan active) (plan-step pending)))
     (provider-records ((provider-request (role planner) (provider fake-local))
                        (provider-result (proposal code-action))
                        (provider-result (proposal finish))))
     (budget ((max-steps 8) (used-steps 2) (used-host-calls 1)
              (used-pure-cost 4)))
     (transcript ((agent-yield replace-helper)
                  (agent-progress observing)
                  (model-route code-action)
                  (capability-call file-write)
                  (model-route finish)))
     (audit-summary ((capability-calls 1) (denials 0)))
     (final-result (task-result (status complete)))))
